{
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background-color: #fff5e6;
  color: #4b3621;
  line-height: 1.6;
}

header {
  background-color: #c67845;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 1.5rem;
  font-weight: bold;
}

nav a {
  color: #ffffff;
  margin-left: 1rem;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  text-decoration: underline;
}

.hero {
  text-align: center;
  padding: 3rem 1rem;
  background-image: url("https://upload.wikimedia.org/wikipedia/commons/5/5a/Lviv_Food.jpg");
  background-repeat: no-repeat;
  background-position: center;
  background-size: cover;
  color: #ffffff;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.8);
}

.hero h1 {
  font-size: 3rem;
  margin-bottom: 1rem;
}

section {
  padding: 2rem 1rem;
  max-width: 1100px;
  margin: 0 auto;
}

h2 {
  color: #7c4a2e;
  margin-bottom: 1rem;
  text-align: center;
}

.card-container {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
}

.card {
  background-color: #f8ede1;
  border-radius: 10px;
  padding: 1rem;
  width: 300px;
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card img {
  width: 100%;
  border-radius: 10px;
  margin-bottom: 0.5rem;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
}

footer {
  text-align: center;
  padding: 1rem;
  background-color: #c67845;
  color: #ffffff;
  margin-top: 2rem;
}

@media (max-width: 768px) {
  header {
    flex-direction: column;
    gap: 0.5rem;
  }

  nav a {
    margin: 0 0.5rem;
  }

  .hero h1 {
    font-size: 2.2rem;
  }

  .card {
    width: 100%;
    max-width: 350px;
  }
}
